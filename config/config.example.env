# Copy this file to config/config.env and edit the paths for a local project.
# No server-specific path is required by the workflow.
export PROJECT_ROOT="/path/to/project"

# Inputs
export RAW_VCF="${PROJECT_ROOT}/input/genotypes/raw.vcf.gz"
export REMOVE_MULE_LIST="${PROJECT_ROOT}/input/metadata/remove_mule.txt"
export REMOVE_SAMPLE_LIST="${PROJECT_ROOT}/input/metadata/remove_sample_for_analysis.txt"
export STRUCTURE_VCF="${PROJECT_ROOT}/input/genotypes/structure.vcf.gz"
export STRUCTURE_BFILE="${PROJECT_ROOT}/work/qc/structure_markers"
export PHENOTYPE_ROOT="${PROJECT_ROOT}/input/phenotypes"
export GWAS_TRAIT_MANIFEST="${PROJECT_ROOT}/input/phenotypes/gwas_traits.tsv"
export SAMPLE_METADATA="${PROJECT_ROOT}/input/metadata/sample_metadata.tsv"
export SELECTION_VCF="${PROJECT_ROOT}/input/genotypes/selection.vcf.gz"
export SELECTION_GROUP_ROOT="${PROJECT_ROOT}/input/selection/groups"
export SELECTION_GROUP_MANIFEST="${PROJECT_ROOT}/input/selection/groups.tsv"
export SELECTION_REGIONS="${PROJECT_ROOT}/results/selection/candidate_regions.tsv"
export SELECTION_RAW_ROOT="${PROJECT_ROOT}/work/selection/raw"
export SELECTION_TRAITS="trait_a trait_b"
export HAPLOTYPE_REGIONS="${PROJECT_ROOT}/input/selection/candidate_regions.tsv"
export ROBUSTNESS_SCENARIO_MANIFEST="${PROJECT_ROOT}/input/selection/robustness_scenarios.tsv"
export GFF3="${PROJECT_ROOT}/input/annotation/genes.gff3.gz"
export VEP_INPUT_BIM="${PROJECT_ROOT}/work/qc/final_qc.bim"
export VEP_VCF="${PROJECT_ROOT}/results/annotation/variants_vep.vcf.gz"
export VEP_CACHE_DIR="${PROJECT_ROOT}/reference/vep"
export VEP_FASTA="${PROJECT_ROOT}/reference/genome.fa"
export LEAD_TABLE="${PROJECT_ROOT}/results/association/lead_loci.tsv"

# Outputs
export QC_ROOT="${PROJECT_ROOT}/work/qc"
export STRUCTURE_ROOT="${PROJECT_ROOT}/work/structure"
export ADMIXTURE_ROOT="${PROJECT_ROOT}/work/admixture"
export GWAS_GENOTYPE_ROOT="${PROJECT_ROOT}/input/gwas_genotypes"
export GWAS_AUTOSOMAL_ROOT="${PROJECT_ROOT}/work/gwas/autosomal"
export GWAS_MATRIX_ROOT="${PROJECT_ROOT}/work/gwas/matrices"
export GWAS_RESULT_ROOT="${PROJECT_ROOT}/results/association"
export SELECTION_RESULT_ROOT="${PROJECT_ROOT}/results/selection"
export ANNOTATION_RESULT_ROOT="${PROJECT_ROOT}/results/annotation"
export ROBUSTNESS_ROOT="${PROJECT_ROOT}/results/robustness"
export HAPLOTYPE_ROOT="${PROJECT_ROOT}/work/haplotype"

# Tools
export PLINK2_BIN="plink2"
export PLINK1_BIN="plink"
export RSCRIPT_BIN="Rscript"
export VCFTOOLS_BIN="vcftools"
export BCFTOOLS_BIN="bcftools"
export VCF2DIS_BIN="VCF2Dis"
export FASTME_BIN="fastme"
export ADMIXTURE_BIN="admixture"
export VEP_BIN="vep"
export BEAGLE_JAR="beagle.jar"
export THREADS="8"
export BEAGLE_MEMORY="16g"
